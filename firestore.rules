
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && getUserData().data.role == 'Administrador';
    }

    function isOperator() {
      let userRole = getUserData().data.role;
      return isSignedIn() && (userRole == 'Operador' || userRole == 'Administrador');
    }

    match /users/{userId} {
      allow get: if isAdmin() || isUser(userId);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /equipments/{equipmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /officers/{officerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /loans/{loanId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
